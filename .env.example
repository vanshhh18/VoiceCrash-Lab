# VoiceCrashLab's own LLM/STT services
GROQ_API_KEY=
GROQ_SCENARIO_MODEL=openai/gpt-oss-120b
GROQ_JUDGE_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
VOICECRASHLAB_TTS_VOICE=hi-IN-SwaraNeural

# Target agent connection is entered in the dashboard.
# Optional environment defaults for CLI adapter use:
VOICE_AGENT_ENDPOINT=
VOICE_AGENT_NAME=
VOICE_AGENT_TOKEN=
VOICE_AGENT_INPUT_FIELD=audio
VOICE_AGENT_TIMEOUT=60
VOICE_AGENT_AUTH_HEADER=Authorization
VOICE_AGENT_AUTH_SCHEME=Bearer
VOICE_AGENT_RESPONSE_TEXT_FIELD=response
VOICE_AGENT_RESPONSE_AUDIO_URL_FIELD=audio_url
